generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  CUSTOMER
  RESTAURANT
  ADMIN
  DELIVERY_PARTNER
}

enum RestaurantStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum ListingStatus {
  ACTIVE
  SOLD_OUT
  EXPIRED
  DELISTED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  ARRIVED_AT_RESTAURANT
  PICKED_UP
  EN_ROUTE
  DELIVERED
  FAILED
}

enum PartnerAvailability {
  ONLINE
  OFFLINE
  ON_DELIVERY
}

// ─────────────────────────────────────────────
// CORE MODELS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String?
  firebaseUid  String?  @unique
  name         String
  role         Role     @default(CUSTOMER)
  avatarUrl    String?
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant      Restaurant?
  orders          Order[]
  addresses       Address[]
  cart            CartItem[]
  reviews         Review[]
  deliveryPartner DeliveryPartner?
  notifications   Notification[]

  @@index([email])
  @@map("users")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  latitude  Float
  longitude Float
  isDefault Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Restaurant {
  id             String           @id @default(cuid())
  ownerId        String           @unique
  name           String
  description    String?
  logoUrl        String?
  bannerUrl      String?
  cuisineTags    String[]
  gstNumber      String?
  fssaiLicense   String?
  status         RestaurantStatus @default(PENDING)
  commissionRate Float            @default(15.0)
  address        String
  city           String
  latitude       Float
  longitude      Float
  avgRating      Float            @default(0)
  isOpen         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  owner    User       @relation(fields: [ownerId], references: [id])
  listings Listing[]
  orders   Order[]
  payouts  Payout[]
  reviews  Review[]

  @@index([city])
  @@index([status])
  @@map("restaurants")
}

model Listing {
  id              String        @id @default(cuid())
  restaurantId    String
  title           String
  description     String?
  imageUrl        String?
  category        String
  originalPrice   Decimal       @db.Decimal(10, 2)
  discountedPrice Decimal       @db.Decimal(10, 2)
  quantityTotal   Int
  quantityLeft    Int
  expiresAt       DateTime
  status          ListingStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([restaurantId])
  @@index([status, expiresAt])
  @@map("listings")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("cart_items")
}

model Order {
  id               String          @id @default(cuid())
  orderNumber      String          @unique @default(cuid())
  customerId       String
  restaurantId     String
  status           OrderStatus     @default(PLACED)
  paymentStatus    PaymentStatus   @default(PENDING)
  paymentMethod    String?
  subtotal         Decimal         @db.Decimal(10, 2)
  platformFee      Decimal         @db.Decimal(10, 2)
  totalAmount      Decimal         @db.Decimal(10, 2)
  pickupCode       String          @unique
  pickupWindowFrom DateTime
  pickupWindowTo   DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  fulfillmentType  FulfillmentType @default(PICKUP)

  // Delivery relations
  deliveryAddressId String?
  deliveryAddress   Address?            @relation(fields: [deliveryAddressId], references: [id])
  deliveryFee       Decimal             @default(0) @db.Decimal(10, 2)
  assignment        DeliveryAssignment?

  customer   User        @relation(fields: [customerId], references: [id])
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  items      OrderItem[]
  review     Review?

  @@index([customerId])
  @@index([restaurantId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  listingId    String
  quantity     Int
  priceAtOrder Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])

  @@map("order_items")
}

model Payout {
  id           String    @id @default(cuid())
  restaurantId String
  amount       Decimal   @db.Decimal(10, 2)
  periodStart  DateTime
  periodEnd    DateTime
  status       String    @default("PENDING")
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@map("payouts")
}

model Review {
  id           String   @id @default(cuid())
  orderId      String   @unique
  customerId   String
  restaurantId String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  customer   User       @relation(fields: [customerId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@map("reviews")
}

// ─────────────────────────────────────────────
// DELIVERY MODELS
// ─────────────────────────────────────────────

model DeliveryPartner {
  id              String              @id @default(cuid())
  userId          String              @unique
  vehicleType     String // "BIKE" | "BICYCLE" | "SCOOTER"
  licensePlate    String?
  availability    PartnerAvailability @default(OFFLINE)
  currentLat      Float?
  currentLng      Float?
  lastPingAt      DateTime?
  rating          Float               @default(5.0)
  totalDeliveries Int                 @default(0)
  isVerified      Boolean             @default(false)
  createdAt       DateTime            @default(now())

  user        User                 @relation(fields: [userId], references: [id])
  assignments DeliveryAssignment[]

  @@index([availability])
  @@map("delivery_partners")
}

model DeliveryAssignment {
  id               String         @id @default(cuid())
  orderId          String         @unique
  partnerId        String
  status           DeliveryStatus @default(ASSIGNED)
  assignedAt       DateTime       @default(now())
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  currentLat       Float?
  currentLng       Float?
  otpForDropoff    String // customer confirms handoff with this code
  distanceKm       Float?
  estimatedMinutes Int?

  order   Order           @relation(fields: [orderId], references: [id])
  partner DeliveryPartner @relation(fields: [partnerId], references: [id])

  @@index([status])
  @@map("delivery_assignments")
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String?
  discountType  String // "PERCENT" | "FLAT"
  discountValue Decimal  @db.Decimal(10, 2)
  minOrderValue Decimal? @db.Decimal(10, 2)
  maxDiscount   Decimal? @db.Decimal(10, 2)
  usageLimit    Int?
  usedCount     Int      @default(0)
  validFrom     DateTime
  validTo       DateTime
  isActive      Boolean  @default(true)

  @@map("coupons")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String // "ORDER_UPDATE" | "OFFER" | "SYSTEM"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}
